
{
    "manifest_version": 3,
    "name": "Mindful-Scroll",
    "version": "1.0",
    "description": "Control the time you spend on social media",

    "permissions": ["tabs", "scripting", "storage"],

    "host_permissions": [
                "*://*.youtube.com/*",
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.reddit.com/*",
                "*://*.instagram.com/*",
                "*://*.facebook.com/*",
                "*://*.tiktok.com/*"
            ],

    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.reddit.com/*",
                "*://*.instagram.com/*",
                "*://*.facebook.com/*",
                "*://*.tiktok.com/*"
            ],
            "js": ["content.js"],
            "css": ["styles.css"]
        }
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    }
}
